# Copy to .env.local (next dev) or .env (Docker) and fill in.
# .env* is gitignored — never commit real secrets.

# HMAC key that signs session cookies. Generate with:
#   openssl rand -hex 32
# Optional: without it, MITS generates a key once and stores it in
# <data dir>/auth-secret so restarts do not log everyone out. Set it explicitly
# when several instances share a database or when the data dir is not persistent.
BETTER_AUTH_SECRET=

# Public base URL, e.g. https://mits.firma.de. Without it the origin is derived
# from the incoming request — fine for a single host, wrong behind a proxy that
# rewrites Host.
BETTER_AUTH_URL=

# Extra origins allowed to call the auth endpoints, comma-separated. Only needed
# when the frontend is served from a different origin than the API.
MITS_TRUSTED_ORIGINS=

# Where runtime state lives: mits.db (users, sessions, tickets, settings) and
# auth-secret. Keep it OUTSIDE the repo; it is gitignored and never pushed.
# Defaults to ./data. Point it at a throwaway directory when testing auth so
# test accounts do not land in the real database.
MITS_DATA_DIR=
