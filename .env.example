# Copy to .env (Docker/Portainer) or .env.local (next dev) and fill in.
# .env* is gitignored — never commit real secrets.

# ── Required ────────────────────────────────────────────────────────────────

# HMAC key that signs session cookies. Generate with:
#   openssl rand -hex 32
# Outside Docker this is optional: MITS then generates a key once and stores it in
# <data dir>/auth-secret so restarts do not log everyone out. In the compose stack
# it is mandatory, because an unset value would be regenerated on every rebuild.
BETTER_AUTH_SECRET=

# Shared secret between mits-web and mits-backend. The backend refuses every
# request without it, so both services must see the same value. Generate with:
#   openssl rand -hex 32
MITS_SERVICE_TOKEN=

# Where the existing Ollama instance listens. If it runs on the Docker host
# itself, use http://host.docker.internal:11434 — docker-compose.yml maps that
# name to the host gateway.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── Optional ────────────────────────────────────────────────────────────────

# Public base URL, e.g. https://mits.firma.de. Without it the origin is derived
# from the incoming request — fine for a single host, wrong behind a proxy that
# rewrites Host.
BETTER_AUTH_URL=

# Extra origins allowed to call the auth endpoints, comma-separated. Only needed
# when the frontend is served from a different origin than the API.
MITS_TRUSTED_ORIGINS=

# Host port the web app is published on.
MITS_WEB_PORT=3000

# Ollama models. Both must be pulled on the Ollama host:
#   ollama pull llama3.1 && ollama pull llava
OLLAMA_TEXT_MODEL=llama3.1
OLLAMA_VISION_MODEL=llava
# Vision inference on CPU takes tens of seconds — raise this rather than lower it.
OLLAMA_TIMEOUT_SECONDS=120

# Where runtime state lives: mits.db (users, sessions, tickets, settings) and
# auth-secret. Inside the container this is the mounted volume at /app/data.
# Outside Docker it defaults to ./data. Point it at a throwaway directory when
# testing auth so test accounts do not land in the real database.
MITS_DATA_DIR=

# Base URL of the AI backend. Set by docker-compose; only needed for `next dev`
# against a locally running uvicorn (http://localhost:8000).
MITS_BACKEND_URL=
