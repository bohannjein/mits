# NOTHING HERE IS REQUIRED.
#
# The Docker stack deploys with an empty environment: both secrets are generated
# on first start into the mits-data volume, and everything about the AI setup is
# configured in the UI. This file exists for the cases where you want to override
# a value — copy it to .env (Docker/Portainer) or .env.local (next dev).
#
# .env* is gitignored — never commit real secrets.

# ── Secrets: only to override the generated ones ────────────────────────────

# HMAC key that signs session cookies. Unset, MITS generates one and stores it in
# <data dir>/auth-secret, so sessions survive restarts and redeploys. Set it
# explicitly when several instances must share sessions, or when the data
# directory is not persistent. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Shared secret between mits-web and mits-backend. Unset, the web app generates it
# into <data dir>/service-token, which the backend mounts read-only. Set it on both
# services if they do not share a volume. Generate with: openssl rand -hex 32
MITS_SERVICE_TOKEN=

# ── Optional ────────────────────────────────────────────────────────────────

# Public base URL, e.g. https://mits.firma.de. Without it the origin is derived
# from the incoming request — fine for a single host, wrong behind a proxy that
# rewrites Host.
BETTER_AUTH_URL=

# Extra origins allowed to call the auth endpoints, comma-separated. Only needed
# when the frontend is served from a different origin than the API.
MITS_TRUSTED_ORIGINS=

# Host port the web app is published on.
MITS_WEB_PORT=3000

# ── Ollama: normally NOT set here ───────────────────────────────────────────
#
# Endpoint and models are configured in the UI under /admin/settings/ai and kept
# in the database. Nothing below has to be set; the variables only act as a
# fallback per field, for the window before an admin opens that page.
#
#   effective value = UI setting -> environment variable -> built-in default
#
# Built-in defaults: http://host.docker.internal:11434, llama3.1, llava.
OLLAMA_BASE_URL=
OLLAMA_TEXT_MODEL=
OLLAMA_VISION_MODEL=

# Vision inference on CPU takes tens of seconds — raise this rather than lower it.
# Backend-side only; not configurable in the UI.
OLLAMA_TIMEOUT_SECONDS=120

# Where runtime state lives: mits.db (users, sessions, tickets, settings) and
# auth-secret. Inside the container this is the mounted volume at /app/data.
# Outside Docker it defaults to ./data. Point it at a throwaway directory when
# testing auth so test accounts do not land in the real database.
MITS_DATA_DIR=

# Base URL of the AI backend. Set by docker-compose; only needed for `next dev`
# against a locally running uvicorn (http://localhost:8000).
MITS_BACKEND_URL=
