# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# python backend (phase 3)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.pem
*.key

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
logs/

# local runtime data (users, sessions, tickets, auth secret) — never committed
#
# Anchored with a leading slash, and that is not tidiness: an unanchored `data/`
# matches a directory of that name at *every* depth, so it also swallowed
# `src/app/admin/settings/data/` — the whole "Daten & Aufbewahrung" page was
# ignored and never committed. It built locally and was missing from every image
# CI produced, which is the worst shape a gitignore mistake can take: invisible
# in the working copy, absent in production.
/data/
.tmp-e2e/
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
auth-secret

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors
.idea/
.vscode/*
!.vscode/settings.json
